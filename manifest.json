{
  "manifest_version": 3,
  "name": "Youtube Scroll Saver",
  "version": "1.1.7",
  "description": "__MSG_description__",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/bookmark_16.png",
      "48": "icons/bookmark_48.png",
      "128": "icons/bookmark_128.png"
    }
  },
  "icons": {
    "16": "icons/bookmark_16.png",
    "48": "icons/bookmark_48.png",
    "128": "icons/bookmark_128.png"
  }
}