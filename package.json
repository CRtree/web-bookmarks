{
  "name": "web-bookmarks",
  "version": "1.0.0",
  "description": "Chrome extension that remembers your scroll position on YouTube channels and restores it when you return.",
  "main": "background.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "verify:i18n": "node tools/verify-i18n.mjs",
    "verify:layout": "node tools/verify-layout.mjs",
    "verify:click-save": "node tools/verify-click-save.mjs",
    "verify:duration": "node tools/verify-duration.mjs",
    "verify:transfer": "node tools/verify-transfer.mjs",
    "screenshots": "node tools/screenshot-layouts.mjs",
    "package": "./package.sh",
    "assets": "bash tools/marketing/build.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CRtree/web-bookmarks.git"
  },
  "keywords": [
    "youtube",
    "scroll position",
    "resume",
    "chrome extension"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CRtree/web-bookmarks/issues"
  },
  "homepage": "https://github.com/CRtree/web-bookmarks#readme",
  "dependencies": {
    "playwright": "^1.61.1"
  }
}
